# Copy to .env and replace every value. .env is gitignored; never commit it.
# Keep values free of spaces and quotes (the Makefile includes this file).

# Postgres superuser (only used by the container's init script)
POSTGRES_PASSWORD=change-me-postgres
# Per-service database users
LEDGER_DB_PASSWORD=change-me-ledger-db
AGENT_DB_PASSWORD=change-me-agent-db

# Ledger API keys (min 16 chars each). One key per role.
#   CLIENT   -> simulator / load test (create accounts, transfers, deposits, reversals)
#   READONLY -> mcp-server (GET endpoints only)
#   ADMIN    -> agent-service approval endpoint only (freeze / unfreeze / reconcile)
LEDGER_CLIENT_API_KEY=change-me-client-key-0000
LEDGER_READONLY_API_KEY=change-me-readonly-key-0000
LEDGER_ADMIN_API_KEY=change-me-admin-key-0000

# Investigation agent LLM. Default: a local Ollama model, free, no API key.
#   ollama    -> Ollama running natively on the host (install it, then `ollama pull qwen2.5:3b`)
#   anthropic -> optional; set ANTHROPIC_API_KEY (and prices below for cost tracking)
#   fake      -> deterministic keyless stand-in (pipeline demo only, never for eval numbers)
# LLM_MODEL is required and never hardcoded.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
# Outside Docker (tests, local runs) and from inside containers respectively.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
OLLAMA_NUM_CTX=8192
# Only for LLM_PROVIDER=anthropic. Leave empty otherwise.
ANTHROPIC_API_KEY=
# USD per million tokens, for the cost estimate. Ignored for ollama/fake (always $0).
LLM_INPUT_USD_PER_MTOK=0
LLM_OUTPUT_USD_PER_MTOK=0
# Small-model limits: per LLM call timeout, tool calls and wall clock per case, tool output size.
LLM_TIMEOUT_S=180
AGENT_MAX_TOOL_CALLS=12
AGENT_INVESTIGATE_TIMEOUT_S=300
AGENT_TOOL_OUTPUT_MAX_CHARS=3000
# Parallel investigations. 1 for a CPU model (Ollama serves one request at a time).
AGENT_CONCURRENCY=1

# Simulated seconds per real second. 3600 = one simulated hour per second, so the simulator's 10-day
# scenario set runs in ~4 minutes. The detector divides all its rule windows by the same number.
# Use 1 for real-time traffic.
SIM_TIME_SCALE=3600

# Ledger limits
LEDGER_MAX_AMOUNT_MINOR=1000000000
LEDGER_IDEMPOTENCY_TTL=PT24H
