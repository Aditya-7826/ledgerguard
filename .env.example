# Copy to .env and replace every value. .env is gitignored; never commit it.
# Keep values free of spaces and quotes (the Makefile includes this file).

# Postgres superuser (only used by the container's init script)
POSTGRES_PASSWORD=change-me-postgres
# Per-service database users
LEDGER_DB_PASSWORD=change-me-ledger-db
AGENT_DB_PASSWORD=change-me-agent-db

# Ledger API keys (min 16 chars each). One key per role.
#   CLIENT   -> simulator / load test (create accounts, transfers, deposits, reversals)
#   READONLY -> mcp-server (GET endpoints only)
#   ADMIN    -> agent-service approval endpoint only (freeze / unfreeze / reconcile)
LEDGER_CLIENT_API_KEY=change-me-client-key-0000
LEDGER_READONLY_API_KEY=change-me-readonly-key-0000
LEDGER_ADMIN_API_KEY=change-me-admin-key-0000

# Investigation agent LLM. LLM_MODEL is required for anthropic: set it to the model you want; it is
# never hardcoded. LLM_PROVIDER=fake runs a deterministic keyless stand-in (pipeline demo only, not eval).
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
# Optional, for the cost estimate in agent_runs/eval (USD per million tokens). 0 = not tracked.
LLM_INPUT_USD_PER_MTOK=0
LLM_OUTPUT_USD_PER_MTOK=0
AGENT_CONCURRENCY=4

# Simulated seconds per real second. 3600 = one simulated hour per second, so the simulator's 10-day
# scenario set runs in ~4 minutes. The detector divides all its rule windows by the same number.
# Use 1 for real-time traffic.
SIM_TIME_SCALE=3600

# Ledger limits
LEDGER_MAX_AMOUNT_MINOR=1000000000
LEDGER_IDEMPOTENCY_TTL=PT24H
